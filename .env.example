
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>

# Admin login credentials
ADMIN_USERNAME=choose-a-private-username
ADMIN_PASSWORD_HASH=paste-bcrypt-hash-here

# Session signing secret
SESSION_SECRET=replace-with-at-least-32-random-characters

# AES-256 tracking-code encryption key (64 hexadecimal characters)
TRACKING_CODE_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
